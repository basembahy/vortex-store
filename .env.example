# ============================================
# Vortex Store - Environment Configuration
# ============================================

# Server Port
PORT=5000
NODE_ENV=production

# Database (Render Free PostgreSQL / Neon / Supabase)
# Leave empty to use local zero-setup dev database, or paste your PostgreSQL connection string:
DATABASE_URL=postgres://vortex_db_user:YOUR_PASSWORD@dpg-xxxxxxxxxxxx-a.oregon-postgres.render.com/vortex_db

# Security & Authentication
JWT_SECRET=vortex_store_super_secure_random_jwt_key_2026_xyz

# Default Super Admin Account (Created automatically on initial run)
ADMIN_EMAIL=admin@vortex.store
ADMIN_PASSWORD=V0rt3x$2026#Admin!Xb0x

# Google OAuth 2.0 Client ID (Obtained from Google Cloud Console)
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
